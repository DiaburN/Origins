  "mechanicalHighlights": {
    "warrior": {
      "Slaying": "Passive/attack proc that periodically arms a stronger Slaying hit.",
      "HalfMoon": "Toggle attack modifier adding adjacent secondary hits.",
      "DestructiveSurge": "360-degree adjacent attack; augment can add a second ring.",
      "ShoulderDash": "Movement plus push; Assault adds paralysis/silence to pushed targets.",
      "CrushingWave": "Forward wave/line with lateral secondary cells.",
      "ElementalSwords": "Self buff that autonomously fires stored swords at nearby enemies."
    },
    "wizard": {
      "FireWall": "Persistent ground hazard.",
      "FireBounce": "Fire projectile that bounces between nearby enemies.",
      "Asteroid": "Large fire area; if FireWall is learned it schedules FireWall zones after impact.",
      "ChainLightning": "Damage propagates between targets with diminishing power.",
      "FrostBite": "Temporary self buff that ends in a delayed nearby frost burst.",
      "ElementalHurricane": "Channel/toggle field whose element can come from DarkStone affinity.",
      "ElectricShock": "Monster-control/taming utility rather than ordinary lightning damage.",
      "Tornado": "Server mechanic exists as a temporary summon despite enum NOT CODED note; visuals/features remain incomplete."
    },
    "taoist": {
      "PoisonDust": "Poison target spell; AugmentPoisonDust expands it to multiple targets.",
      "TrapOctagon": "Persistent eight-part trap that shocks valid monsters.",
      "Parasite": "Poison/status that can later explode around the infected target.",
      "Infection": "Spreads existing poisons from one monster to a nearby monster.",
      "DemonExplosion": "Uses InfernalSoldier pet health for area damage and creates persistent ground zones.",
      "CorpseExploder": "Consumes/clears a corpse and damages around it.",
      "SummonDead": "Converts a valid corpse into an UndeadSoul pet.",
      "BrainStorm": "Works on a Binding target, removes Binding and delivers its follow-up hit/shock."
    },
    "assassin": {
      "lotusCombo": "FullBloom -> WhiteLotus -> RedLotus -> SweetBrier passes short-lived combo buffs; each next stage gains extra power then consumes the prior stage.",
      "Cloak": "HP-cost stealth state; PledgeOfBlood lowers its HP cost and GhostWalk can augment it.",
      "Chain": "Links monsters and constrains movement. ChainOfFire levels add slow, shared/siphoned damage, periodic fire damage and death explosion.",
      "SummonPuppet": "Summon system; ElementalPuppet and ArtOfShadows modify spawned puppets/count/range.",
      "BurningFire": "Persistent ground spell with later explosion hook.",
      "Massacre": "Passive kill proc that splashes overkill-style damage around a killed monster.",
      "LastStand": "Automatic low-HP defensive buff.",
      "DragonBlood": "Attack proc that applies and stacks green poison.",
      "DanceOfSwallow": "Teleports adjacent to target, attacks, then can silence/paralyse."
    }
