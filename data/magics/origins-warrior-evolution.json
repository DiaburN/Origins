{
  "version": 1,
  "status": "design-reference",
  "class": "Warrior",
  "rules": {
    "fixedEvolutionLength": false,
    "designNote": "Do not force every branch to have five stages. Each Warrior branch uses only the number of evolutions that fit its mechanics naturally.",
    "evolutionReplacesPreviousSkill": true,
    "passiveBonusesCanPersistAcrossEvolution": true
  },
  "branches": {
    "line": {
      "status": "locked-direction",
      "evolution": [
        "Slaying",
        "Thrusting",
        "CrushingWave"
      ],
      "stages": [
        {
          "stage": 1,
          "sourceMagic": "Slaying",
          "sourceMagicId": 102,
          "role": "passive foundation",
          "originsBehavior": "Slaying is not an activatable evolution stage in ORIGINS. Its Accuracy and DC bonuses remain permanently learned and continue after the branch evolves."
        },
        {
          "stage": 2,
          "sourceMagic": "Thrusting",
          "sourceMagicId": 103,
          "role": "toggle active",
          "originsBehavior": "Toggle attack that extends the strike forward through additional cells; can be switched on or off."
        },
        {
          "stage": 3,
          "sourceMagic": "CrushingWave",
          "sourceMagicId": 126,
          "role": "active line evolution",
          "originsBehavior": "Final line evolution: projects a long forward wave with lateral secondary coverage."
        }
      ]
    },
    "moon": {
      "status": "locked-direction",
      "evolution": [
        "HalfMoon",
        "DragonRise",
        "FullMoon",
        "FireSword"
      ],
      "stages": [
        {
          "stage": 1,
          "sourceMagic": "HalfMoon",
          "sourceMagicId": 104,
          "role": "toggle frontal sweep"
        },
        {
          "stage": 2,
          "sourceMagic": "DragonRise",
          "sourceMagicId": 107,
          "role": "charged wider sweep"
        },
        {
          "stage": 3,
          "sourceMagic": "DestructiveSurge",
          "sourceMagicId": 109,
          "originsName": "FullMoon",
          "role": "360-degree sword sweep",
          "originsBehavior": "Destructive Surge supplies the mechanics for the ORIGINS FullMoon stage: a complete circular attack around the Warrior."
        },
        {
          "stage": 4,
          "sourceMagic": "FireSword",
          "sourceMagicId": 136,
          "role": "fire-enhanced circular final evolution"
        }
      ]
    },
    "dash": {
      "status": "locked-direction",
      "evolution": [
        "ShoulderDash",
        "Assault",
        "HundredFist"
      ],
      "stages": [
        {
          "stage": 1,
          "sourceMagic": "ShoulderDash",
          "sourceMagicId": 105,
          "role": "dash and push"
        },
        {
          "stage": 2,
          "sourceMagic": "Assault",
          "sourceMagicId": 115,
          "role": "enhanced dash/control",
          "originsBehavior": "Promote Zircon's ShoulderDash augment into a real ORIGINS evolution stage, preserving its paralysis/silence control concept."
        },
        {
          "stage": 3,
          "sourceMagic": "HundredFist",
          "sourceMagicId": 133,
          "role": "advanced target rush and heavy displacement"
        }
      ]
    },
    "powerStrike": {
      "status": "locked-direction",
      "evolution": [
        "FlamingSword",
        "DefensiveBlow",
        "BladeStorm"
      ],
      "stages": [
        {
          "stage": 1,
          "sourceMagic": "FlamingSword",
          "sourceMagicId": 106,
          "role": "charged heavy strike"
        },
        {
          "stage": 2,
          "sourceMagic": "DefensiveBlow",
          "sourceMagicId": 130,
          "role": "charged strike with defence reduction"
        },
        {
          "stage": 3,
          "sourceMagic": "BladeStorm",
          "sourceMagicId": 108,
          "role": "triple heavy strike final evolution",
          "originsBehavior": "ORIGINS redesign: uses the defence-reduction concept of DefensiveBlow but delivers three consecutive strikes."
        }
      ]
    }
  },
  "arcaneUtility": {
    "workingName": "Arcane",
    "nameStatus": "provisional",
    "status": "design-direction",
    "controlEvolution": [
      "Beckon",
      "MassBeckon"
    ],
    "skills": {
      "Beckon": {
        "sourceMagicId": 112,
        "role": "single-target pull/control",
        "evolvesTo": "MassBeckon"
      },
      "MassBeckon": {
        "sourceMagicId": 123,
        "role": "mass pull/control"
      },
      "Interchange": {
        "sourceMagicId": 110,
        "role": "position-swap utility"
      }
    },
    "buffs": {
      "Defiance": 111,
      "Might": 113,
      "Endurance": 116,
      "ReflectDamage": 117,
      "Invincibility": 125,
      "ElementalSwords": 131
    },
    "designNote": "Arcane/Utility groups Warrior control, position manipulation and self-buffs rather than forcing these mechanics into offensive evolution branches."
  }
}