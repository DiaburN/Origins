<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows8.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\vendor\zircon\LibraryEditor\LibraryEditor.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="ManagedSquish">
      <HintPath>..\..\vendor\zircon\Components\ManagedSquish.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="NativeSquish_x64">
      <HintPath>..\..\vendor\zircon\Components\NativeSquish_x64.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
