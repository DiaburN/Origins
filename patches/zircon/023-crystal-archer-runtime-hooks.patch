     public sealed partial class PlayerObject : MapObject
     {
+        // Crystal Archer runtime state. The original persists MentalState and
+        // element progress on CharacterInfo; ORIGINS keeps it runtime-only
+        // until the database persistence pass is compile-validated.
+        public byte CrystalArcherMentalState;
+        public byte CrystalArcherMentalStateLevel;
+        public int CrystalArcherElementsLevel;
+
+        public int CrystalArcherOrbCount
+        {
+            get
+            {
+                if (CrystalArcherElementsLevel >= 200) return 4;
+                if (CrystalArcherElementsLevel >= 150) return 3;
+                if (CrystalArcherElementsLevel >= 100) return 2;
+                if (CrystalArcherElementsLevel >= 50) return 1;
+                return 0;
+            }
+        }
+
+        public void CrystalArcherSeedElement(byte meditationLevel)
+        {
+            if (CrystalArcherElementsLevel <= 0)
+                CrystalArcherElementsLevel = meditationLevel >= 3 ? 100 : 50;
+        }
+
+        public void CrystalArcherGatherElement(byte meditationLevel)
+        {
+            CrystalArcherElementsLevel = Math.Min(200, CrystalArcherElementsLevel + 50);
+            int cap = meditationLevel >= 3 ? 200 : 50 * (meditationLevel + 1);
+            CrystalArcherElementsLevel = Math.Min(CrystalArcherElementsLevel, cap);
+        }
