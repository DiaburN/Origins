+        // Crystal-compatible bind point used by the Wizard Teleport spell.
+        // It is intentionally persistent in Users.db and independent from the
+        // current map/location. NPC/start-point wiring can update it later.
+        public MapInfo BindMap
+        {
+            get { return _BindMap; }
+            set
+            {
+                if (_BindMap == value) return;
+                var oldValue = _BindMap;
+                _BindMap = value;
+                OnChanged(oldValue, value, "BindMap");
+            }
+        }
+        private MapInfo _BindMap;
+
+        public Point BindLocation
+        {
+            get { return _BindLocation; }
+            set
+            {
+                if (_BindLocation == value) return;
+                var oldValue = _BindLocation;
+                _BindLocation = value;
+                OnChanged(oldValue, value, "BindLocation");
+            }
+        }
+        private Point _BindLocation;
