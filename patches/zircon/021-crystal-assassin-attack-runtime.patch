+++ b/ServerLibrary/Models/MagicObject.cs
@@
         public virtual bool AttackSkill => false;
         public virtual bool IgnoreAccuracy => false;
         public virtual bool IgnorePhysicalDefense => false;
+        // Crystal DoubleSlash changes the primary attack from AC+Agility to MAC+Agility.
+        public virtual bool UseMagicDefenseForPhysicalAttack => false;
@@
         public virtual void MagicFinalise()
         {
@@
             Player.BuffRemove(BuffType.Transparency);
+            // Crystal assassin stealth is cancelled by starting a different magic,
+            // but the stealth spell being cast must not remove the buff it just applied.
+            if (Type != MagicType.MoonLight)
+                Player.BuffRemove(BuffType.MoonLight);
+            if (Type != MagicType.DarkBody)
+                Player.BuffRemove(BuffType.DarkBody);
+            if (Type != MagicType.MoonMist && Type != MagicType.MoonMist2)
+                Player.BuffRemove(BuffType.MoonMist);
         }
