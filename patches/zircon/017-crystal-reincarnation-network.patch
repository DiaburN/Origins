diff --git a/ServerLibrary/Envir/SConnection.cs b/ServerLibrary/Envir/SConnection.cs
--- a/ServerLibrary/Envir/SConnection.cs
+++ b/ServerLibrary/Envir/SConnection.cs
@@ -1,2 +1,42 @@
         }
+
+        public void Process(C.ReincarnationAccept p)
+        {
+            if (Stage != GameStage.Game || Player == null || !Player.Dead) return;
+
+            PlayerObject host = Player.ReincarnationHost;
+            if (host?.Node != null && host.ReincarnationReady &&
+                host.ActiveReincarnation && host.ReincarnationTarget == Player &&
+                SEnvir.Now < host.ReincarnationExpireTime)
+            {
+                Player.Dead = false;
+                Player.SetHP(Math.Max(1, Player.Stats[Stat.Health] / 2));
+                Player.Broadcast(new S.ObjectRevive
+                {
+                    ObjectID = Player.ObjectID,
+                    Location = Player.CurrentLocation,
+                    Effect = true
+                });
+
+                host.ReincarnationReady = false;
+                host.ActiveReincarnation = false;
+                host.ReincarnationTarget = null;
+                Player.ReincarnationHost = null;
+                return;
+            }
+
+            Player.ReincarnationHost = null;
+        }
+
+        public void Process(C.ReincarnationCancel p)
+        {
+            if (Stage != GameStage.Game || Player == null) return;
+
+            PlayerObject host = Player.ReincarnationHost;
+            if (host != null)
+                host.ReincarnationExpireTime = SEnvir.Now;
+
+            Player.ReincarnationHost = null;
+        }
